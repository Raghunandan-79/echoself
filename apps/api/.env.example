# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Database (Postgres: Neon free tier or local docker) ---
DATABASE_URL=postgresql://echoself:echoself@localhost:5432/echoself

# --- Redis / BullMQ (Upstash free tier or local docker). Leave empty to use in-memory dev queue. ---
REDIS_URL=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Storage: "r2" or "local" (local = dev fallback, files under STORAGE_LOCAL_DIR) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=echoself-private
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# --- AI service (FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# --- Ollama (EchoBot) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Upload limits / quotas ---
MAX_UPLOAD_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=5368709120
