{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/workers/worker.ts",
    "worker:dev": "tsx watch src/workers/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@prisma/client": "^6.16.0",
    "argon2": "^0.43.0",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0",
    "@echoself/shared": "*"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  }
}